# External hostname — must be served at the root of a (sub)domain, not a
# path like snork.co/gitea. The container registry requires this.
GITEA_DOMAIN=gitea.snork.co

# Where SSH clone URLs point. gitea.snork.co resolves to the reverse proxy,
# which doesn't forward SSH — so point this at the Docker host itself
# (a LAN IP, or a separate DNS record like git-ssh.snork.co).
GITEA_SSH_DOMAIN=192.168.1.10
GITEA_SSH_PORT=2222

# Host port the reverse proxy forwards to (matches the old Caddy upstream).
GITEA_HTTP_PORT=8081

POSTGRES_DB=gitea
POSTGRES_USER=gitea
POSTGRES_PASSWORD=change-me   # generate: openssl rand -base64 32
