# ── SearXNG backend ────────────────────────────────────────────────
# Container name works if SearXNG is on the homelab docker network;
# otherwise use its LAN URL (e.g. https://searxng.snork.co).
# SearXNG must have `json` enabled under search.formats in settings.yml.
SEARXNG_URL=http://searxng:8080

# ── HTTP hardening ─────────────────────────────────────────────────
# HARDEN, AUTH_TOKEN and ALLOWED_ORIGINS must be set together.
MCP_HTTP_HARDEN=true

# Generate with: openssl rand -hex 32
MCP_HTTP_AUTH_TOKEN=change-me

# OpenCode sends no Origin header (that's allowed), but hardened mode
# still requires an allowlist — this is just the proxied hostname.
MCP_HTTP_ALLOWED_ORIGINS=https://searxng-mcp.snork.co

# Matched EXACTLY against the Host header, port included. Setting this
# replaces the defaults, so loopback is re-listed for the healthcheck.
#   searxng-mcp.snork.co  → via Caddy (Caddy preserves Host)
#   192.168.1.10:8004     → direct LAN access to the published port
MCP_HTTP_ALLOWED_HOSTS=searxng-mcp.snork.co,192.168.1.10:8004,127.0.0.1:3000,localhost:3000

# One trusted proxy hop (Caddy), so rate limiting and logs see the real
# client IP. Remove if you only ever hit the published port directly.
MCP_HTTP_TRUST_PROXY=1

# ── Search behaviour ───────────────────────────────────────────────
SEARXNG_DEFAULT_LANGUAGE=en
SEARXNG_MAX_RESULTS=10
SEARXNG_MAX_RESULT_CHARS=500

# Smaller tool schemas — useful for small local models via Ollama.
#SEARXNG_LITE_TOOLS=true

# ── Compose interpolation only ─────────────────────────────────────
# Host port for direct LAN access (3000 is already taken by Homepage).
MCP_PUBLISH_PORT=8004
