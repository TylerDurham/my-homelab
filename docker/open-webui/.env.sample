# External URL, served by Caddy over HTTPS (subhost of CADDY_DOMAIN).
WEBUI_URL=https://chat.snork.co

# Host port the reverse proxy forwards to.
WEBUI_HTTP_PORT=8084

# Use http://host.docker.internal:<port> for a backend on this Docker host.
OLLAMA_BASE_URL=http://your-ollama-host:11434
LLAMACPP_BASE_URL=http://your-llamacpp-host:8080/v1
#LLAMACPP_API_KEY=            # only if llama-server runs with --api-key

# host[:port] only. searxng:8080 = container name over the homelab network.
SEARXNG_HOST=searxng:8080

WEBUI_SECRET_KEY=change-me   # generate: openssl rand -hex 32
