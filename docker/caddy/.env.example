# Base domain all homelab hostnames hang off of.
# Caddy issues a single wildcard cert for *.$CADDY_DOMAIN, so new subhosts
# only need a Caddyfile handle block and a LAN DNS record.
CADDY_DOMAIN=yourdomain.com

# Only needed if preflight.sh guesses your Cloudflare zone wrong — it assumes
# the last two labels of CADDY_DOMAIN, which is right for snork.co but wrong
# for multi-part TLDs (home.example.co.uk would need CF_ZONE=example.co.uk).
#CF_ZONE=snork.co

# Cloudflare API token — create at:
#   https://dash.cloudflare.com/profile/api-tokens
# Use "Create Custom Token" with exactly these permissions, scoped to the
# single zone above (not "All zones"):
#   Zone : Zone : Read
#   Zone : DNS  : Edit
CF_API_TOKEN=yourcloudflareapitoken

# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@yourdomain.com

# Plex runs with network_mode: host, on its own machine — so it's reached by
# IP, not by container name, and it never joins the homelab docker network.
PLEX_HOST=hostname_or_ip_addr=

# UniFi gateway / console. Proxied over HTTPS with verification disabled —
# it serves a self-signed cert (CN=unifi.local) that no CA will vouch for.
UNIFI_HOST=hostname_or_ip_addr

HOMEPAGE_HOST=hostname_or_ip_addr

OLLAMA_HOST=hostname_or_ip_addr
